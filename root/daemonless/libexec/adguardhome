#!/bin/sh
# Start adguardhome; /init has already dropped to the run user.
# Paths match official Docker image: /opt/adguardhome/conf and /opt/adguardhome/work

exec /opt/adguardhome/AdGuardHome \
    --config /opt/adguardhome/conf/AdGuardHome.yaml \
    --work-dir /opt/adguardhome/work \
    --no-check-update
